# Copy to .env and fill in from Supabase Dashboard → Project Settings → API Keys.
# The publishable key is safe to expose in the browser; access is enforced by the
# Row Level Security policies in supabase/setup.sql. Never put the secret key here.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
